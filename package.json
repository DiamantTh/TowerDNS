{
  "name": "towerdns-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "dev": "node scripts/build-frontend.mjs --watch",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "frontend:check": "npm run check && npm run typecheck && npm run build && npm run frontend:verify",
    "frontend:verify": "node scripts/verify-frontend.mjs"
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "^5.0.0",
    "@skeletonlabs/skeleton-svelte": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/zxcvbn": "^4.4.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^6.4.5",
    "zxcvbn": "^4.4.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
