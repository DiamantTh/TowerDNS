{% extends 'app/layout.html.twig' %}

{% block title %}Admin-Switch — TowerDNS{% endblock %}

{% block body %}
{% include 'app/_navbar.html.twig' with { user: user, active: 'admin', csrfToken: csrfToken } %}

<section class="section" id="main-content">
    <div class="container" style="max-width: 640px;">
        <h1 class="title">Admin-Switch</h1>
        <p class="subtitle">Temporäre Impersonation für Support-Zwecke. Jede Sitzung wird vollständig protokolliert.</p>

        {% if error %}
        <div class="notification is-danger is-light">
            <button class="delete" onclick="this.parentElement.remove()" aria-label="Meldung schließen"></button>
            {{ error }}
        </div>
        {% endif %}

        {% if activeSession is not null %}
        {# Active session info #}
        <div class="notification is-warning">
            <p class="has-text-weight-semibold mb-2">Aktive Impersonation-Sitzung</p>
            <table class="table is-narrow is-fullwidth mb-3">
                <tr>
                    <th>Sitzungs-ID</th>
                    <td><code>{{ activeSession.id }}</code></td>
                </tr>
                {% if activeSession.effectiveUserId %}
                <tr>
                    <th>Effektiver Benutzer</th>
                    <td><code>{{ activeSession.effectiveUserId }}</code></td>
                </tr>
                {% endif %}
                {% if activeSession.effectiveAccountId %}
                <tr>
                    <th>Account</th>
                    <td>{{ activeSession.effectiveAccountId }}</td>
                </tr>
                {% endif %}
                <tr>
                    <th>Begründung</th>
                    <td>{{ activeSession.reason }}</td>
                </tr>
                <tr>
                    <th>Erstellt</th>
                    <td>{{ activeSession.createdAt }}</td>
                </tr>
                <tr>
                    <th>Läuft ab</th>
                    <td>{{ activeSession.expiresAt }}</td>
                </tr>
            </table>
            <form method="post" action="/admin/switch/end"
                  onsubmit="return confirm('Admin-Switch-Sitzung wirklich beenden?')">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <button class="button is-danger" type="submit">Sitzung beenden</button>
            </form>
        </div>

        {% else %}
        {# Start new session form #}
        <div class="box">
            <form method="post" action="/admin/switch/start">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                <div class="field">
                    <label class="label" for="effective_user_id">Effektiver Benutzer (optional)</label>
                    <div class="control">
                        <input class="input" type="text" id="effective_user_id"
                               name="effective_user_id"
                               placeholder="Benutzer-ID (GUID) — leer lassen für reine Account-Impersonation"
                               pattern="[0-9a-fA-F\-]{36}|">
                    </div>
                    <p class="help">Wenn angegeben, agiert das System als dieser Benutzer.</p>
                </div>

                <div class="field">
                    <label class="label" for="effective_account_id">Account (optional)</label>
                    <div class="control">
                        <input class="input" type="number" id="effective_account_id"
                               name="effective_account_id" min="1"
                               placeholder="Account-ID — leer lassen wenn nicht benötigt">
                    </div>
                </div>

                <div class="field">
                    <label class="label" for="reason">Begründung <span class="has-text-danger">*</span></label>
                    <div class="control">
                        <textarea class="textarea" id="reason" name="reason"
                                  placeholder="Pflichtfeld: Warum wird der Admin-Switch benötigt?"
                                  required rows="3" maxlength="1000"></textarea>
                    </div>
                    <p class="help">Diese Begründung wird im Audit-Log gespeichert.</p>
                </div>

                <div class="field">
                    <div class="control">
                        <button class="button is-warning" type="submit">Admin-Switch starten</button>
                    </div>
                </div>
            </form>
        </div>
        {% endif %}

        <div class="notification is-info is-light mt-4">
            <strong>Hinweis:</strong> Admin-Switch-Sitzungen laufen nach 15 Minuten automatisch ab.
            Alle Aktionen während einer Sitzung werden vollständig im Audit-Log protokolliert.
        </div>
    </div>
</section>
{% endblock %}
