{% extends 'app/layout.html.twig' %}

{% block title %}Zwei-Faktor-Authentifizierung — TowerDNS{% endblock %}

{% block body %}
<section class="section">
    <div class="container" style="max-width: 420px;">
        <h1 class="title has-text-centered">TowerDNS</h1>
        <div class="box">
            <h2 class="subtitle">Zwei-Faktor-Authentifizierung</h2>
            <p class="has-text-grey mb-4">Bitte gib den aktuellen Code aus deiner Authenticator-App ein.</p>

            {% if error %}
                <div class="notification is-danger is-light">
                    {{ error }}
                </div>
            {% endif %}

            <form method="post" action="/login/totp">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                <div class="field">
                    <label class="label" for="code">Einmalcode</label>
                    <div class="control">
                        <input class="input" type="text" id="code" name="code"
                               inputmode="numeric" pattern="[0-9]{6,8}"
                               autocomplete="one-time-code" required autofocus
                               placeholder="12345678">
                    </div>
                </div>

                <div class="field mt-4">
                    <button class="button is-primary is-fullwidth" type="submit">
                        Bestätigen
                    </button>
                </div>
            </form>

            <p class="has-text-centered mt-3">
                <a href="/login" class="has-text-grey-light is-size-7">← Zurück zur Anmeldung</a>
            </p>
        </div>
    </div>
</section>
{% endblock %}
