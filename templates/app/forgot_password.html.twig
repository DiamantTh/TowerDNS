{% extends 'app/layout.html.twig' %}

{% block title %}Passwort vergessen — TowerDNS{% endblock %}

{% block body %}
<section class="section" id="main-content">
    <div class="container" style="max-width: 420px;">
        <h1 class="title has-text-centered">TowerDNS</h1>
        <div class="box">
            <h2 class="subtitle">Passwort zurücksetzen</h2>

            {% if app.request.query.get('sent') %}
                <div class="notification is-success is-light">
                    Falls die angegebene E-Mail-Adresse registriert ist, wurde ein Reset-Link versendet.
                    Bitte prüfe dein Postfach (und den Spam-Ordner).
                </div>
                <p class="mt-4"><a href="/login">Zurück zur Anmeldung</a></p>
            {% else %}
                {% if error is defined and error %}
                    <div class="notification is-danger is-light">{{ error }}</div>
                {% endif %}

                <p class="mb-4">Gib deine E-Mail-Adresse ein. Du erhältst einen Link zum Zurücksetzen deines Passworts.</p>

                <form method="post" action="/password/forgot">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                    <div class="field">
                        <label class="label" for="email">E-Mail</label>
                        <div class="control">
                            <input class="input" type="email" id="email" name="email"
                                   autocomplete="email" required autofocus>
                        </div>
                    </div>

                    <div class="field mt-4">
                        <button class="button is-primary is-fullwidth" type="submit">
                            Reset-Link anfordern
                        </button>
                    </div>
                </form>

                <p class="mt-4 has-text-centered"><a href="/login">Zurück zur Anmeldung</a></p>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
