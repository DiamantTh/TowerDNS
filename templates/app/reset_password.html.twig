{% extends 'app/layout.html.twig' %}

{% block title %}Neues Passwort festlegen — TowerDNS{% endblock %}

{% block body %}
<section class="section" id="main-content">
    <div class="container" style="max-width: 420px;">
        <h1 class="title has-text-centered">TowerDNS</h1>
        <div class="box">
            <h2 class="subtitle">Neues Passwort festlegen</h2>

            {% if error %}
                <div class="notification is-danger is-light">{{ error }}</div>
            {% endif %}

            {% if token %}
                <form method="post" action="/password/reset">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <input type="hidden" name="reset_token" value="{{ token }}">

                    <div class="field">
                        <label class="label" for="password">Neues Passwort</label>
                        <div class="control">
                            <input class="input" type="password" id="password" name="password"
                                   autocomplete="new-password" required autofocus>
                        </div>
                    </div>

                    <div class="field">
                        <label class="label" for="password_confirm">Passwort bestätigen</label>
                        <div class="control">
                            <input class="input" type="password" id="password_confirm" name="password_confirm"
                                   autocomplete="new-password" required>
                        </div>
                    </div>

                    <div class="field mt-4">
                        <button class="button is-primary is-fullwidth" type="submit">
                            Passwort speichern
                        </button>
                    </div>
                </form>
            {% endif %}

            <p class="mt-4 has-text-centered"><a href="/login">Zurück zur Anmeldung</a></p>
        </div>
    </div>
</section>
{% endblock %}
