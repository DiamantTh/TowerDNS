{% extends 'app/layout.html.twig' %}

{% block title %}Dashboard — TowerDNS{% endblock %}

{% block body %}
{% include 'app/_navbar.html.twig' with { user: user, active: 'dashboard', csrfToken: csrfToken } %}

<section class="section">
    <div class="container">
        <h1 class="title">Dashboard</h1>
        <p class="subtitle has-text-grey">Willkommen bei TowerDNS, {{ user.email ?? '' }}.</p>

        <div class="columns mt-4">
            <div class="column is-4">
                <div class="card">
                    <div class="card-content">
                        <p class="title is-5">DNS-Zonen</p>
                        <p class="has-text-grey is-size-7 mb-3">
                            Zonen verwalten, anlegen und löschen.
                        </p>
                        <a class="button is-primary is-fullwidth" href="/zones">Zonen öffnen</a>
                    </div>
                </div>
            </div>
            <div class="column is-4">
                <div class="card">
                    <div class="card-content">
                        <p class="title is-5">Zwei-Faktor-Authentifizierung</p>
                        <p class="has-text-grey is-size-7 mb-3">
                            TOTP aktivieren oder deaktivieren.
                        </p>
                        <a class="button is-light is-fullwidth" href="/profile/totp">Profil öffnen</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
