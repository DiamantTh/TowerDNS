{% extends 'app/layout.html.twig' %}

{% block title %}Rolle bearbeiten — TowerDNS{% endblock %}

{% block body %}
{% include 'app/_navbar.html.twig' with { user: user, active: 'roles', csrfToken: csrfToken } %}

<section class="section" id="main-content">
    <div class="container" style="max-width: 760px;">

        <nav class="breadcrumb mb-4" aria-label="breadcrumbs">
            <ul>
                <li><a href="/roles">Rollen</a></li>
                <li class="is-active"><a>{{ role ? role.name : 'Unbekannt' }}</a></li>
            </ul>
        </nav>

        <h1 class="title">Rolle bearbeiten</h1>

        {% if error %}
        <div class="notification is-danger is-light">{{ error }}</div>
        {% endif %}

        {% if success %}
        <div class="notification is-success is-light">{{ success }}</div>
        {% endif %}

        {% if role is null %}
            <p class="has-text-grey">Rolle nicht gefunden.</p>
        {% elseif role.isSystem %}
            <div class="notification is-info is-light mb-4">
                Dies ist eine Systemrolle und kann nicht bearbeitet werden.
            </div>
            <div class="box">
                <p class="has-text-weight-semibold mb-3">{{ role.name }}</p>
                <div class="columns is-multiline">
                    {% for perm in permissions %}
                    <div class="column is-3">
                        <label class="checkbox" style="opacity: 0.7; pointer-events: none;">
                            <input type="checkbox"
                                   {% if role.has(perm) %}checked{% endif %}
                                   disabled>
                            {{ perm.value }}
                        </label>
                    </div>
                    {% endfor %}
                </div>
                <div class="mt-4">
                    <a class="button" href="/roles">Zurück</a>
                </div>
            </div>
        {% else %}
            <div class="box">
                <form method="post" action="/roles/{{ role.id }}">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                    <div class="field">
                        <label class="label" for="role_name">Name</label>
                        <div class="control">
                            <input class="input" type="text" id="role_name" name="name"
                                   value="{{ role.name }}" required>
                        </div>
                    </div>

                    <div class="field">
                        <label class="label">Berechtigungen</label>
                        <div class="columns is-multiline">
                            {% for perm in permissions %}
                            <div class="column is-3">
                                <label class="checkbox">
                                    <input type="checkbox" name="permissions[]" value="{{ perm.value }}"
                                           {% if role.has(perm) %}checked{% endif %}>
                                    {{ perm.value }}
                                </label>
                            </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="field is-grouped">
                        <div class="control">
                            <button class="button is-primary" type="submit">Speichern</button>
                        </div>
                        <div class="control">
                            <a class="button is-light" href="/roles">Abbrechen</a>
                        </div>
                    </div>
                </form>
            </div>

            <div class="box has-background-danger-light mt-5">
                <h2 class="subtitle has-text-danger">Gefahrenzone</h2>
                <p class="mb-3">Diese Rolle dauerhaft löschen. Diese Aktion kann nicht rückgängig gemacht werden.</p>
                <form method="post" action="/roles/{{ role.id }}/delete"
                      onsubmit="return confirm('Rolle &quot;{{ role.name|e('js') }}&quot; wirklich löschen?')">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <button class="button is-danger" type="submit">Rolle löschen</button>
                </form>
            </div>
        {% endif %}

    </div>
</section>
{% endblock %}
