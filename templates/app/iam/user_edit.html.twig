{% extends 'app/layout.html.twig' %}

{% block title %}{{ target ? target.email : 'Benutzer' }} — TowerDNS{% endblock %}

{% block body %}
{% include 'app/_navbar.html.twig' with { user: currentUser, active: 'users', csrfToken: csrfToken } %}

<section class="section" id="main-content">
    <div class="container">

        <nav class="breadcrumb mb-4" aria-label="breadcrumbs">
            <ul>
                <li><a href="/users">Benutzer</a></li>
                <li class="is-active"><a aria-current="page">{{ target ? target.email : 'Unbekannt' }}</a></li>
            </ul>
        </nav>

        <h1 class="title">{{ target ? target.email : 'Benutzer bearbeiten' }}</h1>

        {% if error %}
        <div class="notification is-danger is-light">
            <button class="delete" onclick="this.parentElement.remove()" aria-label="Meldung schließen"></button>
            {{ error }}
        </div>
        {% endif %}

        {% if success %}
        <div class="notification is-success is-light">
            <button class="delete" onclick="this.parentElement.remove()" aria-label="Meldung schließen"></button>
            {{ success }}
        </div>
        {% endif %}

        {% if target %}

        {# ── Display name ──────────────────────────────────────────────────── #}
        <div class="box mb-5">
            <h2 class="subtitle">Anzeigename</h2>
            <form method="post" action="/users/{{ target.id|url_encode }}">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <input type="hidden" name="action" value="display_name">
                <div class="field has-addons">
                    <div class="control is-expanded">
                        <input class="input" type="text" name="display_name"
                               value="{{ target.displayName ?? '' }}"
                               placeholder="Anzeigename (leer = E-Mail wird verwendet)"
                               maxlength="128">
                    </div>
                    <div class="control">
                        <button class="button is-primary" type="submit">Speichern</button>
                    </div>
                </div>
            </form>
        </div>

        {# ── Role assignment ───────────────────────────────────────────────── #}
        <div class="box mb-5">
            <h2 class="subtitle">Rollenzuweisung</h2>
            <form method="post" action="/users/{{ target.id|url_encode }}">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <div class="columns is-multiline">
                    {% for role in allRoles %}
                    <div class="column is-narrow">
                        <label class="checkbox">
                            <input type="checkbox" name="roles[]" value="{{ role.id }}"
                                {% for assigned in target.roles %}{% if assigned.id == role.id %} checked{% endif %}{% endfor %}>
                            {{ role.name }}
                        </label>
                    </div>
                    {% else %}
                    <div class="column">
                        <span class="has-text-grey">Keine Rollen definiert.</span>
                    </div>
                    {% endfor %}
                </div>
                <div class="field mt-3">
                    <div class="control">
                        <button class="button is-primary" type="submit">Rollen speichern</button>
                    </div>
                </div>
            </form>
        </div>

        {# ── Password reset ────────────────────────────────────────────────── #}
        <div class="box mb-5">
            <h2 class="subtitle">Passwort zurücksetzen</h2>
            <form method="post" action="/users/{{ target.id|url_encode }}">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <input type="hidden" name="action" value="reset_password">
                <div class="field">
                    <label class="label" for="new_password">Neues Passwort (min. 12 Zeichen)</label>
                    <div class="control">
                        <input class="input" type="password" id="new_password" name="new_password"
                               minlength="12" required autocomplete="new-password">
                    </div>
                </div>
                <div class="field">
                    <label class="checkbox">
                        <input type="checkbox" name="keep_api_keys" checked>
                        API-Schlüssel des Benutzers <strong>behalten</strong> (deaktivieren um zu widerrufen)
                    </label>
                </div>
                <div class="field">
                    <div class="control">
                        <button class="button is-warning" type="submit">Passwort zurücksetzen</button>
                    </div>
                </div>
            </form>
        </div>

        {# ── Danger zone ───────────────────────────────────────────────────── #}
        {% if target.id != currentUser.id %}
        <div class="box has-background-danger-light">
            <h2 class="subtitle has-text-danger">Gefahrenzone</h2>
            <form method="post"
                  action="/users/{{ target.id|url_encode }}/delete"
                  onsubmit="return confirm('Benutzer »{{ target.email }}« unwiderruflich löschen?')">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <button class="button is-danger" type="submit">Benutzer löschen</button>
            </form>
        </div>
        {% endif %}

        {% endif %}

    </div>
</section>
{% endblock %}
