{% extends "app::layout" %}

{% block title %}Provider-Zugangsdaten{% endblock %}

{% block content %}
<section class="section">
    <div class="container">
        <h1 class="title">Provider-Zugangsdaten</h1>
        <p class="subtitle">Zugangsdaten für DNS-Provider konfigurieren. Die Daten werden in <code>configs/providers.toml</code> gespeichert.</p>

        {% if error is not null %}
        <div class="notification is-danger">
            <button class="delete"></button>
            {{ error }}
        </div>
        {% endif %}
        {% if success is not null %}
        <div class="notification is-success">
            <button class="delete"></button>
            {{ success }}
        </div>
        {% endif %}

        {# ── deSEC ──────────────────────────────────────────────────────────── #}
        <div class="box">
            <h2 class="title is-5">
                deSEC
                {% if configured.desec %}
                <span class="tag is-success is-light ml-2">Konfiguriert</span>
                {% else %}
                <span class="tag is-warning is-light ml-2">Nicht konfiguriert</span>
                {% endif %}
            </h2>
            <p class="has-text-grey mb-4">Token aus dem deSEC-Konto unter <em>Einstellungen → API-Token</em>.</p>
            <form method="post" action="/credentials">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <input type="hidden" name="provider"   value="desec">
                <div class="field has-addons">
                    <div class="control is-expanded">
                        <input class="input" type="password" name="desec_token"
                               placeholder="{{ configured.desec ? '(gesetzt — neu eingeben zum Ändern)' : 'API-Token' }}"
                               autocomplete="new-password">
                    </div>
                    <div class="control">
                        <button class="button is-link" type="submit">Speichern</button>
                    </div>
                </div>
                {% if configured.desec %}
                <p class="help">Leer lassen und speichern, um den deSEC-Provider zu deaktivieren.</p>
                {% endif %}
            </form>
        </div>

        {# ── PowerDNS ────────────────────────────────────────────────────────── #}
        <div class="box">
            <h2 class="title is-5">
                PowerDNS
                {% if configured.powerdns %}
                <span class="tag is-success is-light ml-2">Konfiguriert</span>
                {% else %}
                <span class="tag is-warning is-light ml-2">Nicht konfiguriert</span>
                {% endif %}
            </h2>
            <p class="has-text-grey mb-4">HTTP-API des PowerDNS Authoritative Servers.</p>
            <form method="post" action="/credentials">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <input type="hidden" name="provider"   value="powerdns">
                <div class="field">
                    <label class="label">API-Basis-URL</label>
                    <div class="control">
                        <input class="input" type="url" name="powerdns_base_url"
                               value="{{ values.powerdns_base_url }}"
                               placeholder="http://localhost:8081">
                    </div>
                </div>
                <div class="field">
                    <label class="label">API-Key</label>
                    <div class="control">
                        <input class="input" type="password" name="powerdns_api_key"
                               placeholder="{{ configured.powerdns ? '(gesetzt — neu eingeben zum Ändern)' : 'API-Key' }}"
                               autocomplete="new-password">
                    </div>
                </div>
                <div class="field">
                    <label class="label">Server-ID</label>
                    <div class="control">
                        <input class="input" type="text" name="powerdns_server_id"
                               value="{{ values.powerdns_server_id }}"
                               placeholder="localhost">
                    </div>
                    <p class="help">Standardmäßig <code>localhost</code>.</p>
                </div>
                <div class="field">
                    <div class="control">
                        <button class="button is-link" type="submit">Speichern</button>
                    </div>
                </div>
                {% if configured.powerdns %}
                <p class="help">URL und API-Key leer lassen und speichern, um PowerDNS zu deaktivieren.</p>
                {% endif %}
            </form>
        </div>

        {# ── Cloudflare ──────────────────────────────────────────────────────── #}
        <div class="box">
            <h2 class="title is-5">
                Cloudflare
                {% if configured.cloudflare %}
                <span class="tag is-success is-light ml-2">Konfiguriert</span>
                {% else %}
                <span class="tag is-warning is-light ml-2">Nicht konfiguriert</span>
                {% endif %}
            </h2>
            <p class="has-text-grey mb-4">API-Token aus dem Cloudflare-Dashboard unter <em>Mein Profil → API-Token</em>. Der Token benötigt <em>Zone:DNS:Edit</em>-Berechtigungen.</p>
            <form method="post" action="/credentials">
                <input type="hidden" name="csrf_token"         value="{{ csrfToken }}">
                <input type="hidden" name="provider"           value="cloudflare">
                <div class="field has-addons">
                    <div class="control is-expanded">
                        <input class="input" type="password" name="cloudflare_api_token"
                               placeholder="{{ configured.cloudflare ? '(gesetzt — neu eingeben zum Ändern)' : 'API-Token' }}"
                               autocomplete="new-password">
                    </div>
                    <div class="control">
                        <button class="button is-link" type="submit">Speichern</button>
                    </div>
                </div>
                {% if configured.cloudflare %}
                <p class="help">Leer lassen und speichern, um Cloudflare zu deaktivieren.</p>
                {% endif %}
            </form>
        </div>

        {# ── INWX ────────────────────────────────────────────────────────────── #}
        <div class="box">
            <h2 class="title is-5">
                INWX
                {% if configured.inwx %}
                <span class="tag is-success is-light ml-2">Konfiguriert</span>
                {% else %}
                <span class="tag is-warning is-light ml-2">Nicht konfiguriert</span>
                {% endif %}
            </h2>
            <p class="has-text-grey mb-4">INWX-Kontodaten. Das Konto muss API-Zugriff haben (kein Zwei-Faktor für API-Benutzer empfohlen).</p>
            <form method="post" action="/credentials">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <input type="hidden" name="provider"   value="inwx">
                <div class="field">
                    <label class="label">Benutzername</label>
                    <div class="control">
                        <input class="input" type="text" name="inwx_username"
                               value="{{ values.inwx_username }}"
                               placeholder="inwx-username"
                               autocomplete="username">
                    </div>
                </div>
                <div class="field">
                    <label class="label">Passwort</label>
                    <div class="control">
                        <input class="input" type="password" name="inwx_password"
                               placeholder="{{ configured.inwx ? '(gesetzt — neu eingeben zum Ändern)' : 'Passwort' }}"
                               autocomplete="new-password">
                    </div>
                </div>
                <div class="field">
                    <div class="control">
                        <button class="button is-link" type="submit">Speichern</button>
                    </div>
                </div>
                {% if configured.inwx %}
                <p class="help">Benutzername und Passwort leer lassen und speichern, um INWX zu deaktivieren.</p>
                {% endif %}
            </form>
        </div>

    </div>
</section>

<script>
document.querySelectorAll('.notification .delete').forEach(btn => {
    btn.addEventListener('click', () => btn.closest('.notification').remove());
});
</script>
{% endblock %}
