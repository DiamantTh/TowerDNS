{% extends 'app/layout.html.twig' %}

{% block title %}Systemeinstellungen — TowerDNS{% endblock %}

{% block body %}
{% include 'app/_navbar.html.twig' with { user: user, active: 'settings', csrfToken: csrfToken } %}

<section class="section">
    <div class="container" style="max-width:720px">

        <h1 class="title">Systemeinstellungen</h1>

        {% if success %}
        <div class="notification is-success is-light">
            <button class="delete" onclick="this.parentElement.remove()"></button>
            {{ success }}
        </div>
        {% endif %}

        {% if error %}
        <div class="notification is-danger is-light">
            <button class="delete" onclick="this.parentElement.remove()"></button>
            {{ error }}
        </div>
        {% endif %}

        <form method="post" action="/settings">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            {# ── Allgemein ──────────────────────────────────────────────── #}
            <div class="box mb-5">
                <h2 class="subtitle">Allgemein</h2>

                <div class="field">
                    <label class="label" for="app_name">Anwendungsname</label>
                    <div class="control">
                        <input class="input" type="text" id="app_name" name="app_name"
                               value="{{ fields.app_name }}" maxlength="120" required>
                    </div>
                    <p class="help">Wird in der Titelleiste und E-Mails verwendet.</p>
                </div>

                <div class="field">
                    <label class="label" for="app_hostname">Hostname (FQDN)</label>
                    <div class="control">
                        <input class="input" type="text" id="app_hostname" name="app_hostname"
                               value="{{ fields.app_hostname }}" maxlength="253" placeholder="beispiel.de">
                    </div>
                    <p class="help">
                        Wird als WebAuthn-RP-ID und für interne Verlinkungen genutzt.
                        Nur Hostname, kein Protokoll-Präfix.
                    </p>
                </div>

                <div class="field">
                    <label class="label" for="theme_name">Theme</label>
                    <div class="control">
                        <input class="input" type="text" id="theme_name" name="theme_name"
                               value="{{ fields.theme_name }}" maxlength="64">
                    </div>
                </div>

                <div class="field">
                    <label class="checkbox">
                        <input type="checkbox" name="app_force_https" value="1"
                               {% if fields.app_force_https %}checked{% endif %}>
                        HTTPS erzwingen
                    </label>
                    <p class="help">
                        Leitet alle HTTP-Anfragen auf HTTPS um. Nur aktivieren wenn ein
                        Reverse-Proxy TLS terminiert.
                    </p>
                </div>

                <div class="field">
                    <label class="checkbox">
                        <input type="checkbox" name="app_debug" value="1"
                               {% if fields.app_debug %}checked{% endif %}>
                        Debug-Modus
                    </label>
                    <p class="help has-text-danger">
                        Gibt detaillierte Fehlermeldungen aus. In der Produktion deaktiviert lassen.
                    </p>
                </div>
            </div>

            {# ── Passwort-Richtlinie ─────────────────────────────────── #}
            <div class="box mb-5">
                <h2 class="subtitle">Passwort-Richtlinie</h2>

                <div class="columns">
                    <div class="column">
                        <div class="field">
                            <label class="label" for="pwd_min_length">Mindestlänge</label>
                            <div class="control">
                                <input class="input" type="number" id="pwd_min_length"
                                       name="pwd_min_length" min="8" max="128"
                                       value="{{ fields.pwd_min_length }}">
                            </div>
                        </div>
                    </div>
                    <div class="column">
                        <div class="field">
                            <label class="label" for="pwd_min_score">Mindeststärke (0–4)</label>
                            <div class="control">
                                <input class="input" type="number" id="pwd_min_score"
                                       name="pwd_min_score" min="0" max="4"
                                       value="{{ fields.pwd_min_score }}">
                            </div>
                            <p class="help">0 = deaktiviert, 4 = sehr stark (zxcvbn-Skala)</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="field">
                <div class="control">
                    <button class="button is-primary" type="submit">Speichern</button>
                </div>
            </div>
        </form>

    </div>
</section>
{% endblock %}
