{% extends 'app/layout.html.twig' %}

{% block title %}Passwort ändern — TowerDNS{% endblock %}

{% block body %}
{% include 'app/_navbar.html.twig' with { user: user, active: 'profile', csrfToken: csrfToken } %}

<section class="section" id="main-content">
    <div class="container" style="max-width: 480px;">
        <h1 class="title">Passwort ändern</h1>

        {% if success %}
            <div class="notification is-success is-light">{{ success }}</div>
        {% endif %}

        {% if error %}
            <div class="notification is-danger is-light">{{ error }}</div>
        {% endif %}

        <div class="box">
            <form method="post" action="/profile/password">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                <div class="field">
                    <label class="label" for="current_password">Aktuelles Passwort</label>
                    <div class="control">
                        <input class="input" type="password" id="current_password" name="current_password"
                               autocomplete="current-password" required>
                    </div>
                </div>

                <div class="field">
                    <label class="label" for="new_password">Neues Passwort</label>
                    <div class="control">
                        <input class="input" type="password" id="new_password" name="new_password"
                               autocomplete="new-password" required>
                    </div>
                    <p class="help">Mindestens 16 Zeichen, möglichst eine Passphrase.</p>
                </div>

                <div class="field">
                    <label class="label" for="confirm_password">Neues Passwort bestätigen</label>
                    <div class="control">
                        <input class="input" type="password" id="confirm_password" name="confirm_password"
                               autocomplete="new-password" required>
                    </div>
                </div>

                <div class="field">
                    <div class="control">
                        <button class="button is-primary" type="submit">Passwort ändern</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
{% endblock %}
