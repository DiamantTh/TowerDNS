{% extends 'app/layout.html.twig' %}

{% block title %}Mein Profil — TowerDNS{% endblock %}

{% block body %}
{% include 'app/_navbar.html.twig' with { user: user, active: 'profile', csrfToken: csrfToken } %}

<section class="section" id="main-content">
    <div class="container" style="max-width: 680px;">
        <h1 class="title">Mein Profil</h1>

        {% if error %}
        <div class="notification is-danger is-light">
            <button class="delete" onclick="this.parentElement.remove()" aria-label="Meldung schließen"></button>
            {{ error }}
        </div>
        {% endif %}

        {% if success %}
        <div class="notification is-success is-light">
            <button class="delete" onclick="this.parentElement.remove()" aria-label="Meldung schließen"></button>
            {{ success }}
        </div>
        {% endif %}

        {# ── Anzeigename ───────────────────────────────────────────────────── #}
        <div class="box mb-4">
            <h2 class="subtitle mb-3">Anzeigename</h2>
            <p class="is-size-7 has-text-grey mb-3">
                Angemeldet als <strong>{{ user.email }}</strong>.
                Der Anzeigename erscheint in der Navigation anstelle der E-Mail-Adresse.
            </p>
            <form method="post" action="/profile">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <div class="field has-addons">
                    <div class="control is-expanded">
                        <input class="input" type="text" name="display_name"
                               value="{{ user.displayName ?? '' }}"
                               placeholder="Anzeigename (leer = E-Mail wird angezeigt)"
                               maxlength="128" autocomplete="nickname">
                    </div>
                    <div class="control">
                        <button class="button is-primary" type="submit">Speichern</button>
                    </div>
                </div>
            </form>
        </div>

        {# ── Passwort ──────────────────────────────────────────────────────── #}
        <div class="box mb-4">
            <div class="level">
                <div class="level-left">
                    <div>
                        <p class="has-text-weight-semibold">Passwort</p>
                        <p class="is-size-7 has-text-grey">Passwort für die Anmeldung ändern</p>
                    </div>
                </div>
                <div class="level-right">
                    <a class="button is-light" href="/profile/password">Ändern</a>
                </div>
            </div>
        </div>

        {# ── TOTP ──────────────────────────────────────────────────────────── #}
        <div class="box mb-4">
            <div class="level">
                <div class="level-left">
                    <div>
                        <p class="has-text-weight-semibold">Zwei-Faktor-Authentifizierung (TOTP)</p>
                        <p class="is-size-7 has-text-grey">
                            {% if totpEnabled %}
                                <span class="tag is-success is-light">Aktiv</span>
                            {% else %}
                                <span class="tag is-warning is-light">Nicht eingerichtet</span>
                            {% endif %}
                        </p>
                    </div>
                </div>
                <div class="level-right">
                    <a class="button is-light" href="/profile/totp">
                        {{ totpEnabled ? 'Verwalten' : 'Einrichten' }}
                    </a>
                </div>
            </div>
        </div>

        {# ── WebAuthn ──────────────────────────────────────────────────────── #}
        <div class="box">
            <div class="level mb-3">
                <div class="level-left">
                    <div>
                        <p class="has-text-weight-semibold">Sicherheitsschlüssel / Passkeys (WebAuthn / FIDO2)</p>
                        <p class="is-size-7 has-text-grey">
                            {{ webAuthnKeys|length }}
                            {{ webAuthnKeys|length == 1 ? 'Schlüssel' : 'Schlüssel' }} registriert
                        </p>
                    </div>
                </div>
                <div class="level-right">
                    <a class="button is-light" href="/profile/webauthn">Verwalten</a>
                </div>
            </div>
            {% if webAuthnKeys|length > 0 %}
            <table class="table is-fullwidth is-narrow is-size-7">
                <thead>
                    <tr><th scope="col">Name</th><th scope="col">Registriert</th><th scope="col">Zuletzt genutzt</th></tr>
                </thead>
                <tbody>
                    {% for key in webAuthnKeys %}
                    <tr>
                        <td>{{ key.name }}</td>
                        <td>{{ key.created_at }}</td>
                        <td>{{ key.last_used_at ?? '–' }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>

    </div>
</section>
{% endblock %}
