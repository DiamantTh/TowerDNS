{% extends 'app/layout.html.twig' %}

{% block title %}Sicherheitsschlüssel — TowerDNS{% endblock %}

{% block body %}
{% include 'app/_navbar.html.twig' with { user: user, active: 'profile', csrfToken: csrfToken } %}

<section class="section" id="main-content">
    <div class="container" style="max-width: 720px;">
        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a href="/profile">Mein Profil</a></li>
                <li class="is-active"><a href="/profile/webauthn" aria-current="page">Sicherheitsschlüssel</a></li>
            </ul>
        </nav>

        <h1 class="title">Sicherheitsschlüssel / Passkeys</h1>
        <p class="subtitle is-6 has-text-grey">
            FIDO2 / WebAuthn-Schlüssel können als zweiter Faktor beim Anmelden genutzt werden.
            Es können mehrere Schlüssel registriert werden.
        </p>

        {% if success %}
            <div class="notification is-success is-light">{{ success }}</div>
        {% endif %}
        {% if error %}
            <div class="notification is-danger is-light">{{ error }}</div>
        {% endif %}

        {# ── Add new key ───────────────────────────────────────────────────── #}
        <div class="box mb-5">
            <p class="has-text-weight-semibold mb-3">Neuen Schlüssel hinzufügen</p>

            <div id="register-error" class="notification is-danger is-light" style="display:none"></div>
            <div id="register-success" class="notification is-success is-light" style="display:none"></div>

            <div class="field has-addons">
                <div class="control is-expanded">
                    <input id="key-name" class="input" type="text" placeholder="Bezeichnung (z.B. YubiKey 5, iPhone)" maxlength="100">
                </div>
                <div class="control">
                    <button id="register-btn" class="button is-primary">Schlüssel registrieren</button>
                </div>
            </div>
            <p class="help">Stelle sicher, dass dein Sicherheitsschlüssel angeschlossen oder bereit ist.</p>
        </div>

        {# ── Key list ──────────────────────────────────────────────────────── #}
        {% if keys|length > 0 %}
        <div class="box">
            <p class="has-text-weight-semibold mb-3">Registrierte Schlüssel ({{ keys|length }})</p>
            <table class="table is-fullwidth">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Registriert</th>
                        <th scope="col">Zuletzt genutzt</th>
                        <th scope="col"><span class="sr-only">Aktionen</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for key in keys %}
                    <tr>
                        <td>{{ key.name }}</td>
                        <td>{{ key.created_at }}</td>
                        <td>{{ key.last_used_at ?? '–' }}</td>
                        <td>
                            <form method="post" action="/profile/webauthn/{{ key.credential_id_url }}/delete"
                                  onsubmit="return confirm('Schlüssel wirklich entfernen?');">
                                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                <button class="button is-small is-danger is-light" type="submit">Entfernen</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="box has-text-centered has-text-grey py-5">
            Noch keine Schlüssel registriert.
        </div>
        {% endif %}
    </div>
</section>

<script>
(function () {
    // ── Base64url helpers ─────────────────────────────────────────────────────

    function bufToB64url(buf) {
        return btoa(String.fromCharCode(...new Uint8Array(buf)))
            .replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
    }

    function b64urlToBuf(b64url) {
        const b64 = b64url.replace(/-/g, '+').replace(/_/g, '/');
        const pad = b64.length % 4 ? '='.repeat(4 - b64.length % 4) : '';
        return Uint8Array.from(atob(b64 + pad), c => c.charCodeAt(0)).buffer;
    }

    // Recursively convert base64url-encoded fields to ArrayBuffers.
    function toBuffer(obj, keys) {
        const out = Object.assign({}, obj);
        for (const k of keys) {
            if (out[k]) out[k] = b64urlToBuf(out[k]);
        }
        return out;
    }

    // ── Registration flow ─────────────────────────────────────────────────────

    async function registerKey() {
        const btn   = document.getElementById('register-btn');
        const name  = document.getElementById('key-name').value.trim();
        const errEl = document.getElementById('register-error');
        const okEl  = document.getElementById('register-success');

        errEl.style.display = 'none';
        okEl.style.display  = 'none';

        if (!name) {
            errEl.textContent = 'Bitte gib einen Namen für den Schlüssel an.';
            errEl.style.display = 'block';
            return;
        }

        btn.classList.add('is-loading');
        btn.disabled = true;

        try {
            // 1. Begin — get creation options from server.
            const beginResp = await fetch('/profile/webauthn/register/begin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'name=' + encodeURIComponent(name) + '&csrf_token=' + encodeURIComponent(document.querySelector('[name=csrf_token]').value),
            });
            const opts = await beginResp.json();
            if (!beginResp.ok) {
                throw new Error(opts.error ?? 'Fehler beim Starten der Registrierung.');
            }

            // 2. Convert base64url → ArrayBuffer for challenge + user.id + excludeCredentials.
            const publicKey = Object.assign({}, opts);
            publicKey.challenge = b64urlToBuf(opts.challenge);
            publicKey.user = Object.assign({}, opts.user, { id: b64urlToBuf(opts.user.id) });
            if (Array.isArray(opts.excludeCredentials)) {
                publicKey.excludeCredentials = opts.excludeCredentials.map(c => ({
                    ...c, id: b64urlToBuf(c.id),
                }));
            }

            // 3. Invoke browser API.
            const credential = await navigator.credentials.create({ publicKey });
            if (!credential) throw new Error('Keine Antwort vom Authenticator.');

            // 4. Encode response buffers as base64url.
            const payload = {
                id:    bufToB64url(credential.rawId),
                rawId: bufToB64url(credential.rawId),
                type:  credential.type,
                response: {
                    clientDataJSON:    bufToB64url(credential.response.clientDataJSON),
                    attestationObject: bufToB64url(credential.response.attestationObject),
                },
            };

            // 5. Finish — send to server.
            const finishResp = await fetch('/profile/webauthn/register/finish', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const finishData = await finishResp.json();
            if (!finishResp.ok) {
                throw new Error(finishData.error ?? 'Registrierung fehlgeschlagen.');
            }

            okEl.textContent = 'Schlüssel erfolgreich registriert!';
            okEl.style.display = 'block';
            setTimeout(() => window.location.reload(), 1200);
        } catch (e) {
            errEl.textContent = e.message ?? 'Unbekannter Fehler.';
            errEl.style.display = 'block';
        } finally {
            btn.classList.remove('is-loading');
            btn.disabled = false;
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('register-btn').addEventListener('click', registerKey);
    });
})();
</script>
{% endblock %}
