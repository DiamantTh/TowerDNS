{% extends 'app/layout.html.twig' %}

{% block title %}{{ zoneId }} — TowerDNS{% endblock %}

{% block body %}
{% include 'app/_navbar.html.twig' with { user: user, active: 'zones', csrfToken: csrfToken } %}

<section class="section">
    <div class="container">

        <nav class="breadcrumb mb-4" aria-label="breadcrumbs">
            <ul>
                <li><a href="/zones">Zonen</a></li>
                <li class="is-active"><a aria-current="page">{{ zoneId }}</a></li>
            </ul>
        </nav>

        <h1 class="title">{{ zoneId }}</h1>

        {% if error %}
        <div class="notification is-danger is-light">
            <button class="delete" onclick="this.parentElement.remove()"></button>
            {{ error }}
        </div>
        {% endif %}

        {# ── Add record ───────────────────────────────────────────────────── #}
        <div class="box mb-5">
            <h2 class="subtitle">Eintrag hinzufügen</h2>
            <form method="post"
                  action="/zones/{{ providerId|url_encode }}/{{ zoneId|url_encode }}/records">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <div class="columns is-multiline">
                    <div class="column is-4">
                        <div class="field">
                            <label class="label">Name</label>
                            <div class="control">
                                <input class="input" type="text" name="name"
                                       placeholder="@ oder sub.example.com" required autocomplete="off">
                            </div>
                        </div>
                    </div>
                    <div class="column is-narrow">
                        <div class="field">
                            <label class="label">Typ</label>
                            <div class="control">
                                <div class="select">
                                    <select name="type">
                                        <option>A</option>
                                        <option>AAAA</option>
                                        <option>CNAME</option>
                                        <option>MX</option>
                                        <option>TXT</option>
                                        <option>NS</option>
                                        <option>SRV</option>
                                        <option>CAA</option>
                                        <option>PTR</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="column is-narrow">
                        <div class="field">
                            <label class="label">TTL</label>
                            <div class="control">
                                <input class="input" type="number" name="ttl"
                                       value="300" min="1" style="width:90px">
                            </div>
                        </div>
                    </div>
                    <div class="column">
                        <div class="field">
                            <label class="label">Inhalt</label>
                            <div class="control">
                                <input class="input" type="text" name="content"
                                       placeholder="1.2.3.4" required autocomplete="off">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="field">
                    <div class="control">
                        <button class="button is-primary" type="submit">Hinzufügen</button>
                    </div>
                </div>
            </form>
        </div>

        {# ── Record list ──────────────────────────────────────────────────── #}
        {% if records is empty %}
        <div class="notification is-info is-light">Keine Einträge vorhanden.</div>
        {% else %}
        <table class="table is-fullwidth is-hoverable is-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Typ</th>
                    <th>TTL</th>
                    <th>Inhalt</th>
                    <th class="has-text-right"></th>
                </tr>
            </thead>
            <tbody>
            {% for record in records %}
            <tr>
                <td><code class="is-family-monospace">{{ record.name }}</code></td>
                <td><span class="tag is-light">{{ record.type.value }}</span></td>
                <td class="has-text-grey">{{ record.ttl }}</td>
                <td><code class="is-family-monospace">{{ record.content }}</code></td>
                <td class="has-text-right">
                    <form method="post"
                          action="/zones/{{ providerId|url_encode }}/{{ zoneId|url_encode }}/records/{{ record.id|url_encode }}/delete"
                          onsubmit="return confirm('Eintrag »{{ record.name }} {{ record.type.value }}« wirklich löschen?')">                        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">                        <button class="button is-small is-danger is-light" type="submit">Löschen</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}

    </div>
</section>
{% endblock %}
