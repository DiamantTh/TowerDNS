<?xml version="1.0"?>
<ruleset name="TowerDNS">
    <description>
        Targeted PHPCS policy. PHP-CS-Fixer remains the sole formatter for
        PER-CS 2.0; this ruleset deliberately checks only constructs that the
        formatter does not govern.
    </description>

    <file>src</file>
    <file>modules</file>
    <file>install/inc</file>

    <arg name="extensions" value="php"/>

    <!--
        These constructs make request handling and secret-bearing code harder
        to reason about. Deliberate process/database method calls are not
        affected: this sniff only matches global function calls.
    -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="create_function" value="null"/>
                <element key="eval" value="null"/>
                <element key="exec" value="null"/>
                <element key="extract" value="null"/>
                <element key="passthru" value="null"/>
                <element key="pcntl_exec" value="null"/>
                <element key="popen" value="null"/>
                <element key="proc_open" value="null"/>
                <element key="shell_exec" value="null"/>
                <element key="system" value="null"/>
                <element key="unserialize" value="null"/>
            </property>
        </properties>
    </rule>
</ruleset>
