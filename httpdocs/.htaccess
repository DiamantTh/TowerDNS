Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^assets/\.releases(?:/|$) - [R=404,END]
    # Precompressed assets are negotiated by asset.php; do not serve sidecars directly.
    RewriteRule ^assets/.*\.(br|zst)$ - [R=404,END]
    RewriteRule ^assets/([A-Za-z0-9_-]+-[A-Za-z0-9_-]{8}\.(js|css))$ asset.php?asset=$1 [END]
    # Only these virtual PHP pages may reach the shared front controller.
    # QSA preserves resource parameters; END prevents a second rewrite pass.
    RewriteRule ^(login|admin|users|roles|accounts|zones|records|dnssec|profile|settings)\.php$ index.php?entry=$1 [END,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule \.php$ - [R=404,END]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [END]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/" no-gzip=1
</IfModule>
