{
    "name": "towerdns/towerdns",
    "description": "Self-hosted, provider-neutral DNS management panel with capability-aware provider adapters.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "keywords": ["dns", "dnssec", "desec", "powerdns", "cloudflare", "inwx", "panel", "multi-provider", "mezzio", "laminas"],
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "bjeavons/zxcvbn-php": "^1.4",
        "devium/toml": "^1.0",
        "doctrine/dbal": "^3.7",
        "doctrine/migrations": "^3.9",
        "google/apiclient": "^2.19",
        "guzzlehttp/guzzle": "^7.8",
        "inwx/domrobot": "^3.6",
        "laminas/laminas-diactoros": "^3.5",
        "laminas/laminas-filter": "^2.35",
        "laminas/laminas-i18n": "^2.28",
        "laminas/laminas-inputfilter": "^2.30",
        "laminas/laminas-permissions-rbac": "^3.4",
        "laminas/laminas-validator": "^2.64",
        "mezzio/mezzio": "^3.20",
        "mezzio/mezzio-csrf": "^1.3",
        "mezzio/mezzio-fastroute": "^3.11",
        "mezzio/mezzio-session": "^1.10",
        "mezzio/mezzio-session-ext": "^1.6",
        "monolog/monolog": "^3.0",
        "ovh/ovh": "^3.5",
        "php-di/php-di": "^7.1",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "sentry/sentry": "^4.10",
        "spomky-labs/otphp": "^11.4",
        "symfony/cache": "^7.0",
        "symfony/console": "^7.0",
        "symfony/mailer": "^7.0",
        "web-auth/webauthn-lib": "^5.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "2.2.14",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "2.6.7",
        "symfony/polyfill-iconv": "^1.37"
    },
    "autoload": {
        "psr-4": {
            "TowerDNS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TowerDNS\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/towerdns"
    ],
    "scripts": {
        "phpstan": "phpstan analyse --configuration=phpstan.neon",
        "lint":    "find src tests modules -name '*.php' -exec php -l {} \\;",
        "test":    "phpunit",
        "cs":      "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "rector":  "rector process",
        "rector-check": "rector process --dry-run",
        "analyse": "@phpstan",
        "check":   ["@lint", "@cs-check", "@rector-check", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.99",
            "ext-intl": "8.4.99"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
